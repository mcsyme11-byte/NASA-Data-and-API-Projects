                           humidity; 0 = bad; 1 = good; X = unknown;
                           (byte 0 is on the left end)
                           - Byte 0: Humidity observation reliability;
                              0 = preliminary;
                              1 = reliable;
                           - Byte 1: Humidity Channel A quality;
                              0 = bad;
                              1 = good;
                           - Byte 2: Humidity Channel B quality;
                              0 = bad;
                              1 = good;
                           - Byte 3: Humidity Channel C quality;
                              0 = bad;
                              1 = good;"
        DATA_TYPE       = CHARACTER
        START_BYTE      = 585
        BYTES           = 8
END_OBJECT      = COLUMN

