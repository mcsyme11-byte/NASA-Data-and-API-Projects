OBJECT          = COLUMN
        COLUMN_NUMBER   = 24
        NAME            = "BRIGHTNESS_TEMP_A_SHORT_TERM_UNCERTAINTY"
        UNIT            = "KELVIN"
        FORMAT          = "F7.2"
        DESCRIPTION     = "Relative systematic uncertainty of the 
                           brightness temperature provided by the GTS
                           Thermopile A (band 8-14 um).
                           It is used to compare particular data of 
                           different sols, inside a 30 sols period.
                           It does not include calibration uncertainties,
                           since they are constant for the comparison"  
        DATA_TYPE       = ASCII_REAL
        START_BYTE      = 252
        BYTES           = 7
END_OBJECT      = COLUMN

